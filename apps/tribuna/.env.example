# --- Supabase -------------------------------------------------------------
# Project Settings → API. La URL y la anon key son públicas (lectura con RLS).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Solo servidor: escribe los datos sincronizados. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- API-Football ---------------------------------------------------------
# "apisports" (dashboard.api-football.com) o "rapidapi".
API_FOOTBALL_PROVIDER=apisports
API_FOOTBALL_KEY=tu_clave
# Año en que empieza la temporada: 2026 = 2026/27.
API_FOOTBALL_SEASON=2026
# Techo propio por debajo de las 100 peticiones/día del plan gratuito.
API_FOOTBALL_DAILY_BUDGET=95
# Competiciones con clasificación que se sincronizan (140 LaLiga, 2 Champions).
API_FOOTBALL_STANDINGS_LEAGUES=140,2
# Segundos mínimos entre dos consultas en directo.
LIVE_POLL_INTERVAL_SECONDS=150
# Opcional: "live-all" usa /fixtures?live=all en vez de /fixtures?ids=
# LIVE_SOURCE=live-all

# --- Cron -----------------------------------------------------------------
# Vercel lo envía como "Authorization: Bearer <CRON_SECRET>" en cada cron.
CRON_SECRET=una_cadena_larga_y_aleatoria
